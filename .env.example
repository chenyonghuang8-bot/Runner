# Local development configuration. Notification preferences are stored locally; no external sender.
APP_ENV=development
APP_TIMEZONE=Asia/Shanghai
APP_PUBLIC_URL=http://localhost:5173
DATABASE_URL=sqlite:///./data/runner.db
PRIVATE_STORAGE_DIR=./data/private
# Generate locally when authentication is implemented. Never expose in VITE_*.
SESSION_SECRET=

# Application AI, independent of Codex's own model settings.
AI_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_MODEL_VERSION_LABEL=DeepSeek-V4.1-Flash
AI_VISION_MODEL=deepseek-flash
AI_COACH_MODEL=deepseek-flash
AI_VISION_THINKING=disabled
AI_COACH_THINKING=enabled
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2
AI_VISION_MAX_OUTPUT_TOKENS=4096
AI_COACH_MAX_OUTPUT_TOKENS=8192
AI_MONTHLY_BUDGET_CNY=20
# Conservative peak prices, CNY per million tokens. Recheck official prices before production.
AI_INPUT_PRICE_CNY_PER_MILLION=2
AI_OUTPUT_PRICE_CNY_PER_MILLION=8

# Initial tuning values; validate with real screenshots.
IMPORT_MAX_FILE_MB=20
IMPORT_MAX_PIXELS=40000000
IMPORT_TILE_HEIGHT_PX=2000
IMPORT_TILE_OVERLAP_PX=200
IMPORT_IMAGE_DETAIL=original
IMPORT_ORIGINAL_RETENTION_DAYS=30

# Weather display: disabled (default) or open_meteo (personal non-commercial prototype).
# Keep disabled until the city search + forecast network acceptance passes. No API key needed.
WEATHER_PROVIDER=disabled
# Local reminder simulation requires an explicit --simulate worker command.
# No external notification provider or token is used.

# Public frontend configuration only.
VITE_API_BASE_URL=/api/v1

# Copy to runtime.env on the deployment host; never put secrets in site.env or frontend.
# Raw env_file: values have no enclosing quotes; requires Docker Compose >=2.30.
SESSION_SECRET=
AI_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_VISION_MODEL=deepseek-flash
AI_COACH_MODEL=deepseek-flash
AI_COACH_THINKING=enabled
AI_MONTHLY_BUDGET_CNY=20
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2
AI_VISION_MAX_OUTPUT_TOKENS=4096
AI_COACH_MAX_OUTPUT_TOKENS=8192
WEATHER_PROVIDER=disabled
APP_TIMEZONE=Asia/Shanghai
IMPORT_MAX_FILE_MB=20
